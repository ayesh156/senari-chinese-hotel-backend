{
  "name": "senari-chinese-hotel-backend",
  "version": "1.0.0",
  "description": "Backend API for Senari Restaurant",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsup src/main.ts --format esm --platform node --target node24 --out-dir dist --sourcemap",
    "start": "node src/main.ts",
    "start:prod": "node src/main.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "seed": "npx prisma db seed",
    "postinstall": "npx prisma generate"
  },
  "prisma": {
    "seed": "ts-node --project prisma/tsconfig.seed.json --esm prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mariadb": "^3.5.3",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/socket.io": "^3.0.1",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
